; ThinkTwice is an independent personal project.
; All dependencies MUST come from the public npm registry.
; This project-local config intentionally overrides any user/global registry
; configuration so the build is reproducible on any machine.
registry=https://registry.npmjs.org/
package-lock=true
save-exact=false
fund=false
audit=true
; Node 20 or newer, as the README says: the `engines` range in package.json is enforced.
engine-strict=true
